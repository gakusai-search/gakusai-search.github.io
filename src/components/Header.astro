---
import { CURRENT_YEAR } from "../config/site";

export interface Props {
  year?: string;
}

const { year = CURRENT_YEAR } = Astro.props;
const homeUrl = year === CURRENT_YEAR ? "/" : `/${year}/`;
---
<header id="header-container">
  <div class="global-header">
    <div class="header-logo">
      <a href={homeUrl}>
        <img src="/img/nav/logo.png" alt="サイトロゴ" class="logo-img" />
      </a>
    </div>
    <div class="header-search">
      <button type="button" class="header-search-btn" id="header-search-btn" aria-label="検索">
        <img src="/img/nav/search.svg" alt="検索" class="search-img" />
      </button>
    </div>
  </div>
</header>
