---
export interface Props {
  size?: number | string;
  width?: number | string;
  height?: number | string;
  color?: string;
  class?: string;
  [key: string]: any;
}

const {
  size = 24,
  width = size,
  height = size,
  color = "currentColor",
  class: className = "",
  ...rest
} = Astro.props;
---

<svg
  width={width}
  height={height}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  {...rest}
>
  <rect x="4" y="4" width="16" height="16" rx="4" stroke={color} stroke-width="2" />
  <circle cx="12" cy="12" r="4" stroke={color} stroke-width="2" />
  <circle cx="17.25" cy="7.25" r="0.75" fill={color} />
</svg>
