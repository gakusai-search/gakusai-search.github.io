---
export interface Props {
  size?: number | string;
  width?: number | string;
  height?: number | string;
  color?: string;
  strokeWidth?: number | string;
  class?: string;
  [key: string]: any;
}

const {
  size = 24,
  width = size,
  height = size,
  color = "currentColor",
  strokeWidth = 2,
  class: className = "",
  ...rest
} = Astro.props;
---

<svg
  width={width}
  height={height}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  {...rest}
>
  <circle cx="12" cy="12" r="9" stroke={color} stroke-width={strokeWidth} />
  <line x1="3" y1="15" x2="21" y2="15" stroke={color} stroke-width={strokeWidth} />
  <line x1="3" y1="9" x2="21" y2="9" stroke={color} stroke-width={strokeWidth} />
  <path d="M12 3C17.3333 8 17.3333 16 12 21" stroke={color} stroke-width={strokeWidth} />
  <path d="M12 3C6.66667 8 6.66667 16 12 21" stroke={color} stroke-width={strokeWidth} />
</svg>
