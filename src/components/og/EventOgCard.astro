---
import type { EventItem } from "../../utils/events";
import fontUrl from "../../../assets/fonts/NotoSansJP-VariableFont_wght.ttf?url";

export interface Props {
  event: EventItem;
}

const { event } = Astro.props;

// display data
const campusName = event.campusName || event.place?.campus || "";
const roomName = event.place?.room || "";
const dateText = event.tags?.date?.join(" / ") || event.datetime || "";
const rawTags = [...(event.tags?.field || []), ...(event.tags?.features || [])];
const tags = [...new Set(rawTags)].slice(0, 12);
---

<style define:vars={{ fontUrl: `url("${fontUrl}")` }}>
  @font-face {
    font-family: "Noto Sans JP Custom";
    src:
      var(--fontUrl) format("truetype-variations"),
      var(--fontUrl) format("truetype");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  .og-card-container {
    font-family: "Noto Sans JP Custom", "Noto Sans JP", sans-serif;
  }
</style>

<!-- 
  【important rules for satori compatibility】
  1. use display: flex (display: grid is not supported)
  2. set overall size to 1200px x 630px
  3. customize layout by editing HTML/style in this component
-->
<div
  class="og-card-container"
  style="display: flex; flex-direction: column; justify-content: space-between; width: 1200px; height: 630px; box-sizing: border-box; padding: 56px 64px; background: var(--main-gradient); color: #ffffff; position: relative; overflow: hidden;"
>
  <!-- background decoration -->
  <div
    style="position: absolute; right: -80px; bottom: -80px; width: 360px; height: 360px; border-radius: 9999px; background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 70%); pointer-events: none;"
  >
  </div>
  <div
    style="position: absolute; left: 40%; top: -100px; width: 400px; height: 400px; border-radius: 9999px; background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0) 70%); pointer-events: none;"
  >
  </div>

  <!-- header -->
  <div
    style="display: flex; flex-direction: row; justify-content: space-between; align-items: center; width: 100%; z-index: 1;"
  >
    <div
      style="display: flex; flex-direction: row; align-items: center; gap: 16px;"
    >
      <div
        style="display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.24); color: #ffffff; font-weight: 700; font-size: 20px; padding: 6px 14px; border-radius: 6px;"
      >
        {event.year}年度
      </div>
    </div>

    <!-- url -->
    <div
      style="display: flex; align-items: center; font-size: 20px; font-weight: 700; opacity: 0.85; letter-spacing: 0.5px;"
    >
      gakusai-search.github.io
    </div>
  </div>

  <!-- main content -->
  <div
    style="display: flex; flex-direction: column; gap: 16px; width: 100%; z-index: 1; align-items: center;"
  >
    <!-- event name -->
    <h1
      style="font-size: 64px; font-weight: 800; line-height: 1.2; margin: 0; padding: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-align: center;"
    >
      {event.name}
    </h1>

    <!-- organizer & campus info -->
    <div
      style="display: flex; flex-direction: column; align-items: center; gap: 6px; width: 100%;"
    >
      <!-- organizer name -->
      {
        event.organizerName && (
          <div style="display: flex; flex-direction: row; align-items: center; justify-content: center; font-size: 28px; font-weight: 600; opacity: 0.95; width: 100%;">
            <span style="margin-right: 8px;">出展:</span>
            <span>{event.organizerName}</span>
          </div>
        )
      }

      <!-- campus name -->
      {
        campusName && (
          <div style="font-size: 28px; font-weight: 500; opacity: 0.92; letter-spacing: 0.5px; text-align: center;">
            {campusName}
          </div>
        )
      }
    </div>

    <!-- date & place -->
    <div
      style="display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 28px; font-size: 26px; font-weight: 600; margin-top: 4px; width: 100%;"
    >
      {
        dateText && (
          <div style="display: flex; flex-direction: row; align-items: center; gap: 10px; background: rgba(0,0,0,0.18); padding: 8px 18px; border-radius: 10px;">
            <span style="font-size: 20px; opacity: 0.85; font-weight: 700;">
              日時
            </span>
            <span>{dateText}</span>
          </div>
        )
      }
      {
        roomName && (
          <div style="display: flex; flex-direction: row; align-items: center; gap: 10px; background: rgba(0,0,0,0.18); padding: 8px 18px; border-radius: 10px;">
            <span style="font-size: 20px; opacity: 0.85; font-weight: 700;">
              場所
            </span>
            <span>{roomName}</span>
          </div>
        )
      }
    </div>
  </div>

  <!-- footer -->
  <div
    style="display: flex; flex-direction: row; justify-content: center; align-items: center; width: 100%; z-index: 1;"
  >
    <!-- tags -->
    <div
      style="display: flex; flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 1000px;"
    >
      {
        tags.map((tag) => (
          <div style="display: flex; align-items: center; background: rgba(255, 255, 255, 0.22); border: 1.5px solid rgba(255, 255, 255, 0.4); padding: 6px 16px; border-radius: 9999px; font-size: 24px; font-weight: 600;">
            #{tag}
          </div>
        ))
      }
    </div>
  </div>
</div>
