---
import { getEventsByYear, getCampusesByYear } from "../utils/events";
import { getSearchFilterCategories } from "../utils/tags";
import { CURRENT_YEAR } from "../config/site";

export interface Props {
  year: string;
}

const { year } = Astro.props;
const projects = getEventsByYear(year);
const campuses = getCampusesByYear(year);
const categories = getSearchFilterCategories(projects);
---

<div
  id="search-modal-backdrop"
  class="search-modal-backdrop"
  aria-hidden="true"
  data-year={year}
  data-current-year={CURRENT_YEAR}
>
  <div
    class="search-modal-container"
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-modal-title"
  >
    <!-- top（top left: close top right: how to use -->
    <div class="modal-top-bar">
      <button
        type="button"
        class="modal-close-btn"
        id="modal-close-btn"
        aria-label="閉じる"
      >
        <svg
          class="modal-close-icon"
          viewBox="0 0 24 24"
          width="28"
          height="28"
          stroke="currentColor"
          stroke-width="2.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <button
        type="button"
        class="main-btn tutorial-btn modal-tutorial-btn"
        id="modal-tutorial-btn"
      >
        このページの使い方
      </button>
    </div>

    <hr class="modal-hr" />

    <!-- free word search -->
    <div class="modal-search-box-wrapper">
      <input
        type="search"
        id="modal-search-input"
        class="modal-search-input"
        placeholder="フリーワード検索"
        autocomplete="off"
      />
    </div>

    <div class="modal-scrollable-tags">
      <section class="modal-category">
        <h2 class="modal-category-title">キャンパスで絞る</h2>
        <div class="modal-tag-list">
          <button type="button" class="main-btn modal-tag-btn" data-campus="all">すべて</button>
          {campuses.map(c => (
            <button type="button" class="main-btn modal-tag-btn" data-campus={c.id}>{c.name}</button>
          ))}
        </div>
      </section>

      {
        categories.map((category) => (
          <section class="modal-category">
            <h2 class="modal-category-title">{category.title}</h2>
            {category.subCategories ? (
              <div class="modal-subcategories">
                {category.subCategories.map((sub) => (
                  <div class="modal-subcategory">
                    <h3
                      class={`modal-subcategory-title ${sub.colorKey ? `cat-${sub.colorKey}` : ""}`}
                    >
                      {sub.title}
                    </h3>
                    <div class="modal-tag-list">
                      {sub.tags.map((tag) => (
                        <button
                          type="button"
                          class={`main-btn modal-tag-btn ${sub.colorKey ? `tag-${sub.colorKey}` : ""}`}
                          data-tag={tag}
                        >
                          #{tag}
                        </button>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="modal-tag-list">
                {category.tags?.map((tag) => (
                  <button
                    type="button"
                    class="main-btn modal-tag-btn"
                    data-tag={tag}
                  >
                    #{tag}
                  </button>
                ))}
              </div>
            )}
          </section>
        ))
      }
    </div>

    <hr class="modal-hr" />

    <!-- bottom（search and clear） -->
    <div class="modal-footer-actions">
      <button
        type="button"
        class="modal-search-btn"
        id="modal-search-submit-btn"
      >
        検&emsp;索
      </button>
      <button
        type="button"
        class="main-btn modal-clear-btn"
        id="modal-clear-btn"
      >
        クリア
      </button>
    </div>
  </div>
</div>

<style>
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100000;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
    padding: 16px;
    box-sizing: border-box;
  }

  .search-modal-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .search-modal-container {
    background-color: var(--color-background-body);
    border: 1.5px solid var(--color-border-main);
    border-radius: 18px;
    width: 90%;
    height: 90%;
    max-width: 380px;
    max-height: 560px;
    display: flex;
    flex-direction: column;
    padding: 20px;
    box-sizing: border-box;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .modal-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  /* top left: close button */
  .modal-close-btn {
    background-color: #dfdfdf;
    border: none;
    border-radius: 8px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s ease;
    flex-shrink: 0;
  }

  .modal-close-btn:hover {
    background-color: #afafaf;
  }

  .modal-close-icon {
    stroke: #272727;
    display: block;
  }

  /* top right: how to use */
  .modal-tutorial-btn {
    margin-bottom: 0;
    font-size: 14px;
    height: 32px;
    cursor: pointer;
  }

  .modal-hr {
    border: none;
    border-top: 1.5px solid var(--color-main);
    margin: 12px 0;
    width: 100%;
    flex-shrink: 0;
  }

  /* free word search */
  .modal-search-box-wrapper {
    margin: 2px 0;
    flex-shrink: 0;
  }

  .modal-search-input {
    width: 100%;
    box-sizing: border-box;
    height: 40px;
    padding: 8px 14px;
    margin-bottom: 16px;
    background-color: var(--color-btn-main);
    border: 1.5px solid var(--color-border-main);
    border-radius: 12px;
    color: var(--color-text-main);
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .modal-search-input:focus {
    border-color: var(--color-main);
  }

  .modal-search-input::placeholder {
    color: color-mix(in srgb, var(--color-text-main) 50%, transparent);
  }

  /* scrollable area */
  .modal-scrollable-tags {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-right: 4px;
    margin-right: -4px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .modal-scrollable-tags::-webkit-scrollbar {
    width: 5px;
  }

  .modal-scrollable-tags::-webkit-scrollbar-track {
    background: transparent;
  }

  .modal-scrollable-tags::-webkit-scrollbar-thumb {
    background-color: var(--color-border-main);
    border-radius: 3px;
  }

  .modal-category {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .modal-category-title {
    font-size: 18px;
    font-weight: bold;
    color: var(--color-text-main);
    text-align: left;
    margin: 0;
  }

  .modal-subcategories {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 2px;
  }

  .modal-subcategory {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .modal-subcategory-title {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-text-main);
    text-align: left;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.85;
  }

  .modal-subcategory-title::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .modal-subcategory-title.cat-performance::before {
    background: var(--tag-gradient-performance);
  }

  .modal-subcategory-title.cat-creative::before {
    background: var(--tag-gradient-creative);
  }

  .modal-subcategory-title.cat-tech::before {
    background: var(--tag-gradient-tech);
  }

  .modal-subcategory-title.cat-society::before {
    background: var(--tag-gradient-society);
  }

  .modal-tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-start;
  }

  .modal-tag-btn {
    cursor: pointer;
    margin-bottom: 0;
    font-size: 13px;
    height: 30px;
    border-radius: 15px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .modal-tag-btn.active {
    background: var(--color-main);
    border-color: var(--color-main);
    color: #ffffff;
  }

  .modal-tag-btn.tag-performance.active,
  .modal-tag-btn.tag-creative.active,
  .modal-tag-btn.tag-tech.active,
  .modal-tag-btn.tag-society.active {
    border-color: transparent;
  }

  .modal-tag-btn.tag-performance.active {
    background: var(--tag-gradient-performance) border-box;
    color: #ffffff;
  }

  .modal-tag-btn.tag-creative.active {
    background: var(--tag-gradient-creative) border-box;
    color: #ffffff;
  }

  .modal-tag-btn.tag-tech.active {
    background: var(--tag-gradient-tech) border-box;
    color: #ffffff;
  }

  .modal-tag-btn.tag-society.active {
    background: var(--tag-gradient-society) border-box;
    color: #121212;
  }

  /* bottom action buttons */
  .modal-footer-actions {
    display: flex;
    width: 100%;
    align-items: center;
    gap: calc(100% * 1 / 22.6);
    margin-top: 2px;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .modal-search-btn {
    flex: 14.4 1 0;
    min-width: 0;
    position: relative;
    background: var(--main-gradient);
    color: #ffffff;
    font-weight: bold;
    font-size: 15px;
    border: none;
    box-shadow: inset 0 0 0 1.5px #ffffff3d;
    height: 36px;
    border-radius: 6px;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  @media (hover: hover) {
    .modal-search-btn:hover {
      opacity: 0.9;
    }
  }

  .modal-clear-btn {
    flex: 7.2 1 0;
    min-width: 0;
    margin-bottom: 0;
    cursor: pointer;
    height: 36px;
    border-radius: 6px;
    padding: 0;
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    white-space: nowrap;
  }
</style>

<script is:inline>
  const initModal = () => {
    const modalBackdrop = document.getElementById("search-modal-backdrop");
    const modalCloseBtn = document.getElementById("modal-close-btn");
    const clearBtn = document.getElementById("modal-clear-btn");
    const searchSubmitBtn = document.getElementById("modal-search-submit-btn");
    const searchInput = document.getElementById("modal-search-input");
    const tagBtns = document.querySelectorAll(".modal-tag-btn");
    const searchTriggers = document.querySelectorAll(
      ".header-search-btn, [data-open-search-modal]",
    );

    // sync modal selections with current URL search params
    function syncModalWithUrl() {
      const params = new URLSearchParams(window.location.search);
      const urlTags = params
        .getAll("tags")
        .flatMap((t) => t.split(","))
        .map((t) => t.trim())
        .filter(Boolean);

      tagBtns.forEach((btn) => {
        const tag = btn.getAttribute("data-tag");
        if (tag && urlTags.includes(tag)) {
          btn.classList.add("active");
        } else {
          btn.classList.remove("active");
        }
      });

      const keyword = params.get("q");
      if (searchInput) {
        searchInput.value = keyword || "";
      }
    }

    // open modal
    function openModal() {
      if (modalBackdrop) {
        syncModalWithUrl();
        modalBackdrop.classList.add("is-open");
        modalBackdrop.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        if (searchInput) {
          setTimeout(() => searchInput.focus(), 100);
        }
      }
    }

    // close modal
    function closeModal() {
      if (modalBackdrop) {
        modalBackdrop.classList.remove("is-open");
        modalBackdrop.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }
    }

    // open via header search button etc.
    searchTriggers.forEach((trigger) => {
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // close button
    if (modalCloseBtn) {
      modalCloseBtn.addEventListener("click", closeModal);
    }

    // close via backdrop click
    if (modalBackdrop) {
      modalBackdrop.addEventListener("click", (e) => {
        if (e.target === modalBackdrop) {
          closeModal();
        }
      });
    }

    // press esc to close
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modalBackdrop?.classList.contains("is-open")) {
        closeModal();
      }
    });

    // toggle to select tags
    tagBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        btn.classList.toggle("active");
      });
    });

    // clear button
    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        tagBtns.forEach((btn) => btn.classList.remove("active"));
        if (searchInput) {
          searchInput.value = "";
          searchInput.focus();
        }
      });
    }

    // function to execute search
    function executeSearch() {
      const selectedTags = Array.from(
        document.querySelectorAll(".modal-tag-btn.active"),
      ).map((btn) => btn.getAttribute("data-tag"));
      const keyword = searchInput?.value.trim() || "";

      // build search parameters
      const params = new URLSearchParams();
      if (keyword) params.set("q", keyword);
      
      // campus filtering
      const selectedCampus = document.querySelector(".modal-tag-btn[data-campus].active");
      if (selectedCampus && selectedCampus.getAttribute("data-campus") !== "all") {
        params.set("campus", selectedCampus.getAttribute("data-campus") || "");
      }

      if (selectedTags.length > 0) params.set("tags", selectedTags.join(","));

      const queryStr = params.toString() ? "?" + params.toString() : "";
      
      const modalBackdrop = document.getElementById("search-modal-backdrop");
      const year = modalBackdrop ? modalBackdrop.getAttribute("data-year") : "2026";
      const currentYear = modalBackdrop ? modalBackdrop.getAttribute("data-current-year") : "2026";
      const isLatest = year === currentYear;
      const basePath = isLatest ? "/events/" : `/${year}/events/`;
      const searchUrl = `${basePath}${queryStr}`;

      closeModal();

      const isEventsPage =
        window.location.pathname.replace(/\/+$/, "").endsWith("/events");

      if (isEventsPage) {
        if (window.location.search !== queryStr) {
          window.history.pushState({}, "", searchUrl);
          window.dispatchEvent(new CustomEvent("searchparamschange"));
        }
        return;
      }

      window.location.href = searchUrl;
    }

    // search button behavior
    if (searchSubmitBtn) {
      searchSubmitBtn.addEventListener("click", executeSearch);
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initModal);
  } else {
    initModal();
  }
</script>
