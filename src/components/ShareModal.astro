---
// src/components/ShareModal.astro
import IconPhotos from "./icons/IconPhotos.astro";
import IconX from "./icons/IconX.astro";
import IconLine from "./icons/IconLine.astro";
---

<div id="share-modal-backdrop" class="share-modal-backdrop" aria-hidden="true">
  <div
    class="share-modal-container"
    role="dialog"
    aria-modal="true"
    aria-labelledby="share-modal-title"
  >
    <!-- header: close button and title -->
    <div class="share-modal-header">
      <button
        type="button"
        class="modal-close-btn"
        id="share-modal-close-btn"
        aria-label="閉じる"
      >
        <svg
          class="modal-close-icon"
          viewBox="0 0 24 24"
          width="28"
          height="28"
          stroke="currentColor"
          stroke-width="2.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div id="share-modal-title" class="share-modal-title">シェア</div>
    </div>

    <!-- 3 rounded square buttons -->
    <div class="share-channels">
      <button
        type="button"
        class="share-channel-btn"
        id="share-btn-x"
        aria-label="X(Twitter)でシェア"
      >
        <span class="share-channel-icon" aria-hidden="true">
          <IconX size={36} color="var(--color-text-main)" />
        </span>
        <span class="share-channel-label">X(Twitter)</span>
      </button>
      <button
        type="button"
        class="share-channel-btn"
        id="share-btn-line"
        aria-label="LINEでシェア"
      >
        <span class="share-channel-icon" aria-hidden="true">
          <IconLine size={36} color="var(--color-text-main)" />
        </span>
        <span class="share-channel-label">LINE (スマホ版)</span>
      </button>
      <button
        type="button"
        class="share-channel-btn"
        id="share-btn-image"
        aria-label="画像でシェア"
      >
        <span
          class="share-channel-icon"
          id="share-image-icon"
          aria-hidden="true"
        >
          <IconPhotos size={36} color="var(--color-text-main)" />
        </span>
        <span class="share-channel-label" id="share-image-label"
          >画像でシェア</span
        >
      </button>
    </div>

    <!-- bottom URL copy button -->
    <button type="button" class="share-url-full-btn" id="share-btn-copy-full">
      URLをコピー
    </button>
  </div>
</div>

<dialog
  id="image-download-modal"
  class="image-download-modal"
  aria-labelledby="image-download-modal-title"
  tabindex="-1"
>
  <div class="image-download-modal-container">
    <div class="image-download-modal-header">
      <button
        type="button"
        class="image-download-close-btn"
        id="image-download-close-btn"
        aria-label="閉じる"
      >
        <svg
          class="image-download-close-icon"
          viewBox="0 0 24 24"
          width="28"
          height="28"
          stroke="currentColor"
          stroke-width="2.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <h2 id="image-download-modal-title" class="image-download-modal-title">
        画像でシェアしよう！
      </h2>
    </div>

    <hr class="image-download-modal-hr" />

    <div class="image-download-modal-body">
      <p class="image-download-text">
        ダウンロードした画像はお使いの端末本体に保存されます。InstagramやTikTok、X(Twitter)、Threadsなど、画像投稿ができるSNSでの投稿にぜひお使いください。
      </p>
    </div>
  </div>
</dialog>

<style>
  .share-modal-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 100000;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
    padding: 16px;
    padding-bottom: max(16px, env(safe-area-inset-bottom));
    box-sizing: border-box;
  }

  .share-modal-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .share-modal-container {
    background-color: var(--color-background-body);
    border: 1.5px solid var(--color-border-main);
    border-radius: 18px;
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    padding: 18px 20px 20px;
    box-sizing: border-box;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    transform: translateY(24px);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .share-modal-backdrop.is-open .share-modal-container {
    transform: translateY(0);
  }

  /* header */
  .share-modal-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 32px;
    margin-bottom: 20px;
  }

  .modal-close-btn {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    background-color: #dfdfdf;
    border: none;
    border-radius: 8px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    margin: 0;
    outline: none;
    transition: background-color 0.2s ease;
    flex-shrink: 0;
    z-index: 1;
  }

  .modal-close-btn:hover {
    background-color: #afafaf;
  }

  .modal-close-icon {
    stroke: #272727;
    display: block;
  }

  .share-modal-title {
    display: block;
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text-main);
    margin: 0;
    text-align: center;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  /* 3 rounded square buttons */
  .share-channels {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 16px;
  }

  .share-channel-btn {
    position: relative;
    overflow: hidden;
    flex: 1;
    aspect-ratio: 1 / 1;
    min-width: 0;
    background-color: var(--color-btn-main);
    border: 1.5px solid var(--color-border-main);
    border-radius: 5px;
    color: var(--color-text-main);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 4px;
    cursor: pointer;
    box-sizing: border-box;
    outline: none;
  }

  .share-channel-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .share-channel-btn:active::before {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0.4);
    transition: background-color 0.1s ease;
  }

  @media (hover: hover) {
    .share-channel-btn:hover::before {
      opacity: 1;
    }
  }

  .share-channel-icon {
    font-size: 32px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
  }

  .share-channel-label {
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    user-select: none;
  }

  /* bottom URL copy button */
  .share-url-full-btn {
    position: relative;
    overflow: hidden;
    font-size: 18px;
    background: var(--main-gradient);
    color: #ffffff;
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.3);
    border: none;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 42px;
    padding: 5px 20px;
    font-weight: bold;
    cursor: pointer;
    box-sizing: border-box;
  }

  .share-url-full-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .share-url-full-btn:active::before {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0.4);
    transition: background-color 0.1s ease;
  }

  @media (hover: hover) {
    .share-url-full-btn:hover::before {
      opacity: 1;
    }
  }

  /* image download guide modal */
  .image-download-modal {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: 480px;
    width: 90%;
    color: var(--color-text-main);
    outline: none;
  }

  .image-download-modal::backdrop {
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: imageDownloadFadeIn 0.25s ease forwards;
  }

  .image-download-modal.is-closing::backdrop {
    animation: imageDownloadFadeOut 0.25s ease forwards;
  }

  .image-download-modal-container {
    background-color: var(--color-background-body);
    border: 1.5px solid var(--color-border-main);
    border-radius: 18px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    max-height: 85vh;
    box-sizing: border-box;
    animation: imageDownloadFadeIn 0.25s ease forwards;
    outline: none;
  }

  .image-download-modal.is-closing .image-download-modal-container {
    animation: imageDownloadFadeOut 0.25s ease forwards;
  }

  @keyframes imageDownloadFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes imageDownloadFadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  .image-download-modal-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 32px;
  }

  .image-download-modal-title {
    margin: 0;
    padding: 0 36px;
    font-size: 20px;
    font-weight: 700;
    color: var(--color-text-main);
    line-height: 1.25;
    text-align: center !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    width: 100%;
    box-sizing: border-box;
  }

  .image-download-close-btn {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    background-color: #dfdfdf;
    border: none;
    border-radius: 8px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    outline: none;
    transition: background-color 0.2s ease;
    flex-shrink: 0;
    z-index: 1;
  }

  .image-download-close-btn:hover {
    background-color: #afafaf;
  }

  .image-download-close-icon {
    stroke: #272727;
    display: block;
  }

  .image-download-modal-hr {
    border: none;
    border-top: 1.5px solid var(--color-main);
    margin: 16px 0;
    width: 100%;
    flex-shrink: 0;
  }

  .image-download-modal-body {
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: left;
  }

  .image-download-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-main);
    opacity: 0.9;
    text-align: left;
  }

  @media (max-width: 480px) {
    .image-download-modal-container {
      padding: 20px 16px;
    }
    .image-download-modal-title {
      font-size: 17px;
      padding: 0 34px;
      text-align: center !important;
      justify-content: center !important;
    }
    .image-download-text {
      font-size: 14px;
    }
  }
</style>

<script>
  function setupShareModal() {
    const backdrop = document.getElementById("share-modal-backdrop");
    if (!backdrop) return;

    if ((backdrop as any)._hasInitialized) return;
    (backdrop as any)._hasInitialized = true;

    const closeBtn = document.getElementById("share-modal-close-btn");
    const xBtn = document.getElementById("share-btn-x");
    const lineBtn = document.getElementById("share-btn-line");
    const imageBtn = document.getElementById("share-btn-image");
    const copyFullBtn = document.getElementById("share-btn-copy-full");

    const imageIcon = document.getElementById("share-image-icon");
    const imageLabel = document.getElementById("share-image-label");

    const downloadModal = document.getElementById(
      "image-download-modal",
    ) as HTMLDialogElement | null;
    const downloadCloseBtn = document.getElementById(
      "image-download-close-btn",
    );

    function openDownloadModal() {
      if (!downloadModal) return;
      downloadModal.showModal();
      downloadCloseBtn?.blur();
      (document.activeElement as HTMLElement)?.blur();
    }

    function closeDownloadModal() {
      if (
        !downloadModal ||
        !downloadModal.open ||
        downloadModal.classList.contains("is-closing")
      )
        return;
      downloadModal.classList.add("is-closing");
      setTimeout(() => {
        downloadModal.close();
        downloadModal.classList.remove("is-closing");
      }, 250);
    }

    if (downloadCloseBtn) {
      downloadCloseBtn.addEventListener("click", closeDownloadModal);
    }

    if (downloadModal) {
      downloadModal.addEventListener("click", (e) => {
        if (e.target === downloadModal) {
          closeDownloadModal();
        }
      });
      downloadModal.addEventListener("cancel", (e) => {
        e.preventDefault();
        closeDownloadModal();
      });
    }

    let currentUrl = window.location.href;
    let currentTitle = document.title;
    let copyResetTimer: ReturnType<typeof setTimeout> | null = null;
    let imageResetTimer: ReturnType<typeof setTimeout> | null = null;

    function openModal(options?: { title?: string; url?: string }) {
      currentUrl = options?.url || window.location.href;
      currentTitle = options?.title || document.title;
      backdrop.classList.add("is-open");
      backdrop.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      backdrop.classList.remove("is-open");
      backdrop.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    (window as any).openShareModal = openModal;
    (window as any).closeShareModal = closeModal;

    // click outside backdrop to close
    backdrop.addEventListener("click", (e) => {
      if (e.target === backdrop) {
        closeModal();
      }
    });

    // close on button click
    if (closeBtn) {
      closeBtn.addEventListener("click", closeModal);
    }

    // close on Escape key
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && backdrop.classList.contains("is-open")) {
        closeModal();
      }
    });

    // share to X (Twitter)
    if (xBtn) {
      xBtn.addEventListener("click", () => {
        const text = `${currentTitle}\n`;
        const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(currentUrl)}`;
        window.open(xUrl, "_blank", "noopener,noreferrer,width=550,height=450");
      });
    }

    // share to LINE (smartphone)
    if (lineBtn) {
      lineBtn.addEventListener("click", () => {
        const lineUrl = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(currentUrl)}`;
        window.open(
          lineUrl,
          "_blank",
          "noopener,noreferrer,width=550,height=520",
        );
      });
    }

    // get square share image URL
    function getSquareShareImageUrl(): string {
      const pathname = window.location.pathname.replace(/\/$/, "");
      // event detail: /[year]/events/[id]
      // organizer detail: /organizers/[id]
      if (
        /\/\d{4}\/events\/[^/]+$/.test(pathname) ||
        /\/organizers\/[^/]+$/.test(pathname)
      ) {
        return `${pathname}/square.png`;
      }

      // fallback: meta[property="og:image"]
      const meta = document.querySelector<HTMLMetaElement>(
        'meta[property="og:image"]',
      );
      if (meta && meta.content) {
        return meta.content;
      }

      return `${pathname}/square.png`;
    }

    // download square share image
    async function downloadSquareShareImage() {
      const imageUrl = getSquareShareImageUrl();
      const baseName = (currentTitle.split("｜")[0] || "share-card").trim();
      const safeFileName = `${baseName.replace(/[\\/:*?"<>|]/g, "_")}_square.png`;

      try {
        if (imageLabel) imageLabel.textContent = "読み込み中...";

        const response = await fetch(imageUrl);
        if (!response.ok) throw new Error("fetch failed");
        const blob = await response.blob();
        const blobUrl = URL.createObjectURL(blob);

        const a = document.createElement("a");
        a.href = blobUrl;
        a.download = safeFileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);

        closeModal();
        openDownloadModal();
      } catch (e) {
        console.warn(
          "Direct blob download failed, falling back to link download:",
          e,
        );
        const fallbackA = document.createElement("a");
        fallbackA.href = imageUrl;
        fallbackA.download = safeFileName;
        fallbackA.target = "_blank";
        document.body.appendChild(fallbackA);
        fallbackA.click();
        document.body.removeChild(fallbackA);

        closeModal();
        openDownloadModal();
      } finally {
        if (imageResetTimer) clearTimeout(imageResetTimer);
        imageResetTimer = setTimeout(() => {
          if (imageLabel) imageLabel.textContent = "画像でシェア";
        }, 600);
      }
    }

    if (imageBtn) {
      imageBtn.addEventListener("click", downloadSquareShareImage);
    }

    // clipboard copy logic with UI feedback
    async function copyUrlToClipboard() {
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(currentUrl);
        } else {
          const textarea = document.createElement("textarea");
          textarea.value = currentUrl;
          textarea.style.position = "fixed";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand("copy");
          document.body.removeChild(textarea);
        }

        if (copyFullBtn) {
          copyFullBtn.textContent = "コピーしました！";
        }

        if (copyResetTimer) clearTimeout(copyResetTimer);
        copyResetTimer = setTimeout(() => {
          if (copyFullBtn) {
            copyFullBtn.textContent = "URLをコピー";
          }
        }, 2000);
      } catch (e) {
        console.error("Failed to copy URL:", e);
      }
    }

    if (copyFullBtn) {
      copyFullBtn.addEventListener("click", copyUrlToClipboard);
    }
  }

  // global event delegation for .share-button click
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const shareBtn = target?.closest<HTMLButtonElement>(".share-button");
    if (shareBtn) {
      e.preventDefault();
      if (typeof (window as any).openShareModal === "function") {
        (window as any).openShareModal();
      }
    }
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupShareModal);
  } else {
    setupShareModal();
  }
  document.addEventListener("astro:page-load", setupShareModal);
</script>
