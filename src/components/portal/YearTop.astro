---
import Layout from "../../layouts/Layout.astro";
import "../../styles/index.css";
import type { EventItem } from "../../utils/events";
import { getTagColorClass } from "../../utils/tags";

interface Props {
  year: string;
  events: EventItem[];
  isLatest: boolean;
}

const { year, events, isLatest } = Astro.props;

function getInitialDateStr(): string {
  try {
    const formatter = new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Tokyo",
      month: "2-digit",
      day: "numeric",
      weekday: "short",
    });
    const parts = formatter.formatToParts(new Date());
    const month = parts.find((p) => p.type === "month")?.value || "";
    const day = parts.find((p) => p.type === "day")?.value || "";
    const weekday = parts.find((p) => p.type === "weekday")?.value || "";
    return `${month}/${day} (${weekday})`;
  } catch {
    return "";
  }
}

const initialDate = isLatest ? getInitialDateStr() : "";
const pageTitle = isLatest ? "ホーム｜学祭ポータル" : `${year}年度 ホーム｜学祭ポータル`;
const eventsBasePath = isLatest ? "/events/" : `/${year}/events/`;

// get all tags for the year
const rawTags = [
  ...new Set(
    (events || []).flatMap((e) => [
      ...(e.tags?.campus || (e.campusName ? [e.campusName] : [])),
      ...(e.tags?.date || []),
      ...(e.tags?.format || []),
      ...(e.tags?.field || []),
      ...(e.tags?.features || []),
    ])
  ),
].filter(Boolean);

// shuffle randomly
const shuffledTags = [...rawTags];
for (let i = shuffledTags.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [shuffledTags[i], shuffledTags[j]] = [shuffledTags[j], shuffledTags[i]];
}

// top pics
const c3Events = (events || []).filter((e) => e.organizerId === "c3ofcl");
const itlEvents = (events || []).filter((e) => e.organizerId === "festival_itl");

const selectedC3 =
  c3Events.length > 0
    ? c3Events[Math.floor(Math.random() * c3Events.length)]
    : null;
const selectedItlPrimary =
  itlEvents.length > 0
    ? itlEvents[Math.floor(Math.random() * itlEvents.length)]
    : null;
const firstSlot: EventItem[] = [];
if (selectedC3 && selectedItlPrimary) {
  if (Math.random() < 0.5) {
    firstSlot.push(selectedC3, selectedItlPrimary);
  } else {
    firstSlot.push(selectedItlPrimary, selectedC3);
  }
} else if (selectedC3) {
  firstSlot.push(selectedC3);
} else if (selectedItlPrimary) {
  firstSlot.push(selectedItlPrimary);
}

const remainingItlEvents = selectedItlPrimary
  ? itlEvents.filter((e) => e.id !== selectedItlPrimary.id)
  : [...itlEvents];
const shuffledRemainingItl = [...remainingItlEvents];
for (let i = shuffledRemainingItl.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [shuffledRemainingItl[i], shuffledRemainingItl[j]] = [
    shuffledRemainingItl[j],
    shuffledRemainingItl[i],
  ];
}

const additionalEvents = shuffledRemainingItl.slice(0, 4);
const initialOfficialEvents = [...firstSlot, ...additionalEvents];
const initialOfficialIds = new Set(initialOfficialEvents.map((e) => e.id));

// extract tags assigned to 3 or more events from format/field ones
const formatAndFieldTagMap = new Map<string, EventItem[]>();

(events || []).forEach((e) => {
  const currentTags = [
    ...(e.tags?.format || []),
    ...(e.tags?.field || []),
  ].filter(Boolean);

  const uniqueEventTags = new Set(currentTags);
  uniqueEventTags.forEach((tag) => {
    if (!formatAndFieldTagMap.has(tag)) {
      formatAndFieldTagMap.set(tag, []);
    }
    formatAndFieldTagMap.get(tag)!.push(e);
  });
});

const eligibleTags = Array.from(formatAndFieldTagMap.entries())
  .filter(([_, evList]) => evList.length >= 3)
  .map(([tag]) => tag);

const shuffledEligibleTags = [...eligibleTags];
for (let i = shuffledEligibleTags.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [shuffledEligibleTags[i], shuffledEligibleTags[j]] = [
    shuffledEligibleTags[j],
    shuffledEligibleTags[i],
  ];
}
const initialSelectedTags = shuffledEligibleTags.slice(0, 4);

const pageDescription = isLatest
  ? undefined
  : `${year}年度の学園祭の企画・イベント検索やキャンパスマップ・教室案内など、学園祭を楽しむのに役立つWebサイトです。`;
---

<Layout title={pageTitle} description={pageDescription} year={year}>
  <h1 id={isLatest ? "top-heading" : undefined}>
    {isLatest ? initialDate : `${year}年度 学祭ポータル`}
  </h1>

  {
    shuffledTags.length > 0 && (
      <div class="top_tags_container">
        <section class="button-list top_tags_track" id="top-tags-track">
          {shuffledTags.map((tag) => (
            <button
              type="button"
              class={`main-btn ${getTagColorClass(tag)}`}
              onclick={`location.href='${eventsBasePath}?tags=${encodeURIComponent(tag)}'`}
            >
              #{tag}
            </button>
          ))}
        </section>
      </div>
    )
  }

  {
    (initialOfficialEvents.length > 0 || eligibleTags.length > 0) && (
      <hr class="top-divider" />
    )
  }

  {
    (c3Events.length > 0 || itlEvents.length > 0) && (
      <section class="top_carousel_section" id="official-carousel-section">
        <h2 class="section-title">公式コンテンツ</h2>

        <div class="top_pics_container">
          <div class="top_pics" id="official-pics">
            {initialOfficialEvents.map((ev) => (
              <a
                href={`/${year}/events/${ev.id}/`}
                class="top_pic_item"
                data-organizer={ev.organizerId}
                data-id={ev.id}
              >
                <img
                  src={ev.image || "/img/events/events_hero_example.png"}
                  alt={ev.name}
                />
              </a>
            ))}
            {c3Events
              .filter((ev) => !initialOfficialIds.has(ev.id))
              .map((ev) => (
                <a
                  href={`/${year}/events/${ev.id}/`}
                  class="top_pic_item"
                  data-organizer="c3ofcl"
                  data-id={ev.id}
                  style="display: none;"
                >
                  <img
                    src={ev.image || "/img/events/events_hero_example.png"}
                    alt={ev.name}
                  />
                </a>
              ))}
            {itlEvents
              .filter((ev) => !initialOfficialIds.has(ev.id))
              .map((ev) => (
                <a
                  href={`/${year}/events/${ev.id}/`}
                  class="top_pic_item"
                  data-organizer="festival_itl"
                  data-id={ev.id}
                  style="display: none;"
                >
                  <img
                    src={ev.image || "/img/events/events_hero_example.png"}
                    alt={ev.name}
                  />
                </a>
              ))}
          </div>
        </div>

        <div class="top_pics_indicators">
          <button
            type="button"
            class="main-btn top_pics_arrow_btn prev"
            aria-label="前へスクロール"
            disabled
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="main-btn top_pics_arrow_btn next"
            aria-label="次へスクロール"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </section>
    )
  }

  <div id="tag-sections-container">
    {
      eligibleTags.map((tag) => {
        const matching = formatAndFieldTagMap.get(tag) || [];
        const isInitiallyVisible = initialSelectedTags.includes(tag);
        return (
          <section
            class="top_carousel_section tag_carousel_section"
            data-tag={tag}
            style={isInitiallyVisible ? undefined : "display: none;"}
          >
            <h2 class="section-title">#{tag}</h2>

            <div class="top_pics_container">
              <div class="top_pics">
                {matching.map((ev, idx) => (
                  <a
                    href={`/${year}/events/${ev.id}/`}
                    class="top_pic_item"
                    data-id={ev.id}
                    style={idx < 6 ? undefined : "display: none;"}
                  >
                    <img
                      src={ev.image || "/img/events/events_hero_example.png"}
                      alt={ev.name}
                    />
                  </a>
                ))}
              </div>
            </div>

            <div class="top_pics_indicators">
              <button
                type="button"
                class="main-btn top_pics_arrow_btn prev"
                aria-label="前へスクロール"
                disabled
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <button
                type="button"
                class="main-btn top_pics_arrow_btn next"
                aria-label="次へスクロール"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            </div>
          </section>
        );
      })
    }
  </div>

  <script is:inline>
    (function () {
      var track = document.getElementById("top-tags-track");
      if (track && track.children.length > 1) {
        var items = Array.prototype.slice.call(track.children);
        for (var i = items.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          track.appendChild(items[j]);
        }
      }
    })();

    (function () {
      // 1. official contents cards
      var officialPics = document.getElementById("official-pics");
      if (officialPics) {
        var c3Items = Array.prototype.slice.call(
          officialPics.querySelectorAll('[data-organizer="c3ofcl"]')
        );
        var itlItems = Array.prototype.slice.call(
          officialPics.querySelectorAll('[data-organizer="festival_itl"]')
        );

        if (c3Items.length > 0 || itlItems.length > 0) {
          var selectedC3 =
            c3Items.length > 0
              ? c3Items[Math.floor(Math.random() * c3Items.length)]
              : null;
          var selectedItlPrimary =
            itlItems.length > 0
              ? itlItems[Math.floor(Math.random() * itlItems.length)]
              : null;

          var firstSlot = [];
          if (selectedC3 && selectedItlPrimary) {
            if (Math.random() < 0.5) {
              firstSlot.push(selectedC3, selectedItlPrimary);
            } else {
              firstSlot.push(selectedItlPrimary, selectedC3);
            }
          } else if (selectedC3) {
            firstSlot.push(selectedC3);
          } else if (selectedItlPrimary) {
            firstSlot.push(selectedItlPrimary);
          }

          var remainingItl = itlItems.filter(function (item) {
            return item !== selectedItlPrimary;
          });

          for (var i = remainingItl.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var temp = remainingItl[i];
            remainingItl[i] = remainingItl[j];
            remainingItl[j] = temp;
          }

          var additionalEvents = remainingItl.slice(0, 4);
          var chosenOfficial = firstSlot.concat(additionalEvents);

          var allOfficial = c3Items.concat(itlItems);
          for (var k = 0; k < allOfficial.length; k++) {
            allOfficial[k].style.display = "none";
          }

          for (var m = 0; m < chosenOfficial.length; m++) {
            chosenOfficial[m].style.display = "";
            officialPics.appendChild(chosenOfficial[m]);
          }
        }
      }

      // 2. tag section
      var tagSectionsContainer = document.getElementById("tag-sections-container");
      if (tagSectionsContainer) {
        var sectionNodes = Array.prototype.slice.call(
          tagSectionsContainer.querySelectorAll(".tag_carousel_section")
        );

        if (sectionNodes.length > 0) {
          var shuffledSections = sectionNodes.slice();
          for (var si = shuffledSections.length - 1; si > 0; si--) {
            var sj = Math.floor(Math.random() * (si + 1));
            var sTemp = shuffledSections[si];
            shuffledSections[si] = shuffledSections[sj];
            shuffledSections[sj] = sTemp;
          }

          var selectedSections = shuffledSections.slice(0, 4);

          for (var sk = 0; sk < sectionNodes.length; sk++) {
            sectionNodes[sk].style.display = "none";
          }

          for (var sn = 0; sn < selectedSections.length; sn++) {
            var sec = selectedSections[sn];
            sec.style.display = "";
            tagSectionsContainer.appendChild(sec);

            var picsEl = sec.querySelector(".top_pics");
            if (picsEl) {
              var cardItems = Array.prototype.slice.call(
                picsEl.querySelectorAll(".top_pic_item")
              );
              for (var ci = cardItems.length - 1; ci > 0; ci--) {
                var cj = Math.floor(Math.random() * (ci + 1));
                var cTemp = cardItems[ci];
                cardItems[ci] = cardItems[cj];
                cardItems[cj] = cTemp;
              }
              for (var ca = 0; ca < cardItems.length; ca++) {
                cardItems[ca].style.display = "none";
              }
              var visibleCards = cardItems.slice(0, 6);
              for (var cb = 0; cb < visibleCards.length; cb++) {
                visibleCards[cb].style.display = "";
                picsEl.appendChild(visibleCards[cb]);
              }
            }
          }
        }
      }
    })();

    (function () {
      var sections = document.querySelectorAll(".top_carousel_section");
      sections.forEach(function (section) {
        var container = section.querySelector(".top_pics_container");
        var prevBtn = section.querySelector(".top_pics_arrow_btn.prev");
        var nextBtn = section.querySelector(".top_pics_arrow_btn.next");
        if (!container || !prevBtn || !nextBtn) return;

        function updateIndicator() {
          var maxScrollLeft = container.scrollWidth - container.clientWidth;
          var currentLeft = container.scrollLeft;

          if (maxScrollLeft <= 5) {
            prevBtn.disabled = true;
            nextBtn.disabled = true;
            return;
          }

          var firstItem = container.querySelector(".top_pic_item");
          var lastItem = container.querySelector(".top_pic_item:last-child");
          var containerRect = container.getBoundingClientRect();

          var canScrollLeft = currentLeft > 10;
          if (firstItem) {
            var firstRect = firstItem.getBoundingClientRect();
            if (firstRect.left >= containerRect.left - 8) {
              canScrollLeft = false;
            }
          }

          var canScrollRight = currentLeft < maxScrollLeft - 10;
          if (lastItem) {
            var lastRect = lastItem.getBoundingClientRect();
            if (lastRect.right <= containerRect.right + 8) {
              canScrollRight = false;
            }
          }

          prevBtn.disabled = !canScrollLeft;
          nextBtn.disabled = !canScrollRight;
        }

        prevBtn.addEventListener("click", function () {
          var scrollAmount = container.clientWidth * 0.75;
          if (container.scrollLeft <= scrollAmount) {
            container.scrollTo({ left: 0, behavior: "smooth" });
          } else {
            container.scrollBy({ left: -scrollAmount, behavior: "smooth" });
          }
        });

        nextBtn.addEventListener("click", function () {
          var scrollAmount = container.clientWidth * 0.75;
          container.scrollBy({ left: scrollAmount, behavior: "smooth" });
        });

        container.addEventListener("scroll", updateIndicator, { passive: true });
        if ("onscrollend" in window) {
          container.addEventListener("scrollend", updateIndicator);
        }
        window.addEventListener("resize", updateIndicator);

        var images = container.querySelectorAll("img");
        for (var k = 0; k < images.length; k++) {
          if (images[k].complete) {
            updateIndicator();
          } else {
            images[k].addEventListener("load", updateIndicator);
          }
        }

        updateIndicator();
        setTimeout(updateIndicator, 100);
        setTimeout(updateIndicator, 500);
      });
    })();
  </script>


  {isLatest && (
    <script is:inline>
      (function () {
        function updateDate() {
          var heading = document.getElementById("top-heading");
          if (!heading) return;
          try {
            var formatter = new Intl.DateTimeFormat("en-US", {
              timeZone: "Asia/Tokyo",
              month: "2-digit",
              day: "numeric",
              weekday: "short",
            });
            var parts = formatter.formatToParts(new Date());
            var month = "";
            var day = "";
            var weekday = "";
            for (var i = 0; i < parts.length; i++) {
              if (parts[i].type === "month") month = parts[i].value;
              if (parts[i].type === "day") day = parts[i].value;
              if (parts[i].type === "weekday") weekday = parts[i].value;
            }
            if (month && day && weekday) {
              heading.textContent = month + "/" + day + " (" + weekday + ")";
            }
          } catch (e) {
            console.error("Failed to update date", e);
          }
        }
        updateDate();
      })();
    </script>
  )}
</Layout>
