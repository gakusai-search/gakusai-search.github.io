---
import Layout from "../../layouts/Layout.astro";
import "../../styles/events.css";
import { getAllOrganizers, getEventsByOrganizer } from "../../utils/events";
import { getTagColorClass, getFieldTagColorClass } from "../../utils/tags";
import { CURRENT_YEAR } from "../../config/site";

export async function getStaticPaths() {
  const organizers = getAllOrganizers();
  return organizers.map((organizer) => ({
    params: { id: organizer.id },
    props: {
      organizer,
      events: getEventsByOrganizer(organizer.id),
    },
  }));
}

const { organizer, events } = Astro.props;

function getAccountHref(service: string, rawVal: string): string {
  const val = rawVal.trim();
  if (
    val.startsWith("http://") ||
    val.startsWith("https://") ||
    val.startsWith("mailto:")
  ) {
    return val;
  }

  const s = service.toLowerCase();
  const withoutAt = val.replace(/^@/, "");

  if (s === "x" || s === "twitter") {
    return `https://x.com/${withoutAt}`;
  }
  if (s === "instagram" || s === "insta") {
    return `https://instagram.com/${withoutAt}`;
  }
  if (s === "threads") {
    return `https://threads.net/${withoutAt}`;
  }
  if (s === "facebook" || s === "fb") {
    return `https://facebook.com/${withoutAt}`;
  }
  if (s === "line") {
    return `https://line.me/R/ti/p/@${withoutAt}`;
  }
  if (s.includes("オープンチャット") || s.includes("openchat")) {
    if (val.startsWith("ti/g2/")) {
      return `https://line.me/${val}`;
    }
    return `https://line.me/ti/g2/${withoutAt}`;
  }
  if (s === "linktree" || s === "linkreee") {
    return `https://linktr.ee/${withoutAt}`;
  }
  if (s === "discord") {
    const invite = val.replace(
      /^(https?:\/\/)?(discord\.gg\/|discord\.com\/invite\/)/,
      "",
    );
    return `https://discord.gg/${invite}`;
  }
  if (s === "github") {
    return `https://github.com/${withoutAt}`;
  }
  if (s === "youtube" || s === "yt") {
    return `https://youtube.com/${val.startsWith("@") ? val : `@${val}`}`;
  }
  if (s === "tiktok") {
    return `https://tiktok.com/@${withoutAt}`;
  }
  if (s === "mail" || s === "email" || s === "メール") {
    return `mailto:${val.replace(/\[at\]/g, "@")}`;
  }
  if (s === "web" || s === "hp" || s === "website") {
    return `https://${val}`;
  }

  return "";
}
---

<Layout title={`${organizer.name}｜企画者紹介｜学祭ポータル`} hideNav={true}>
  <button
    onclick="if (window.history.length > 1 && document.referrer && document.referrer.startsWith(window.location.origin)) { history.back(); } else { location.href='/organizers/'; }"
    class="back-button">←戻る</button
  >
  <button class="share-button"
    ><img src="/img/icons/share.svg" alt="シェア" /></button
  >

  <div class="organizer-detail-page">
    <div class="page-header">
      <div class="page-title">
        <h1>{organizer.name}</h1>
      </div>
    </div>

    <!-- profile section -->
    <div class="organizer-profile-card">
      {
        organizer.description && (
          <div class="organizer-description">
            <p>{organizer.description}</p>
          </div>
        )
      }

      {
        organizer.accounts && Object.keys(organizer.accounts).length > 0 && (
          <details class="organizer-accounts">
            <summary class="accounts-summary">
              <span>公式アカウント・リンク</span>
              <img src="/img/maps/arrow.svg" alt="" class="summary-arrow" />
            </summary>
            <div class="accounts-grid">
              {Object.entries(organizer.accounts).map(([service, val]) => {
                const href = getAccountHref(service, val);
                return (
                  <div class="account-item">
                    <span class="account-service">{service}</span>
                    {href ? (
                      <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="account-link"
                      >
                        {val}
                      </a>
                    ) : (
                      <span class="account-val">{val}</span>
                    )}
                  </div>
                );
              })}
            </div>
          </details>
        )
      }
    </div>

    <script is:inline>
      (function () {
        const details = document.querySelector(".organizer-accounts");
        if (details && window.matchMedia("(min-width: 768px)").matches) {
          details.open = true;
        }
      })();
    </script>

    <hr />

    <!-- event list -->
    <div class="organizer-events-section">
      <div class="section-header">
        <h2>企画一覧</h2>
        <span class="events-count">{events.length}件</span>
      </div>

      {
        events.length > 0 ? (
          <div class="events-grid">
            {events.map((project) => {
              const allTags = [
                ...(project.tags?.campus ||
                  (project.campusName ? [project.campusName] : [])),
                ...(project.tags?.date || []),
                ...(project.tags?.format || []),
                ...(project.tags?.field || []),
                ...(project.tags?.features || []),
              ];
              const cardColorClass = getFieldTagColorClass(project.tags?.field);

              return (
                <a
                  href={`/${project.year}/events/${project.id}`}
                  class={`event-card ${cardColorClass}`.trim()}
                  data-id={project.id}
                >
                  <div class="card-image-wrap">
                    <img
                      src={project.image}
                      alt={project.name}
                      loading="lazy"
                    />
                    <span class="year-badge">{project.year}年度</span>
                  </div>
                  <div class="event-card-content">
                    <h3>{project.name}</h3>
                    <div class="event-card-tags">
                      {allTags.map((tag) => (
                        <span
                          class={`tag-span ${getTagColorClass(tag)}`}
                          data-tag={tag}
                        >
                          #{tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="no-events-card">
            <p>現在登録されている企画はありません。</p>
          </div>
        )
      }
    </div>
  </div>
</Layout>

<style>
  .organizer-detail-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 20px 0 60px;
  }

  .page-header {
    margin-bottom: 24px;
  }

  .page-title {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .page-title h1 {
    font-size: 1.6rem;
    font-weight: bold;
    margin: 0;
    color: var(--color-text-main);
  }

  .organizer-profile-card {
    background-color: var(--color-btn-main);
    border: 1px solid var(--color-border-main);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 32px;
    color: var(--color-text-main);
  }

  .organizer-description p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-main);
    opacity: 0.9;
    margin: 0 0 20px;
    white-space: pre-wrap;
  }

  .organizer-accounts {
    margin-top: 16px;
    border-top: 1px solid var(--color-border-main);
    padding-top: 12px;
  }

  .accounts-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-size: 1rem;
    font-weight: bold;
    color: var(--color-text-main);
    user-select: none;
    list-style: none;
    padding: 4px 0;
  }

  .accounts-summary::-webkit-details-marker {
    display: none;
  }

  .summary-arrow {
    width: 20px;
    height: 20px;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  details[open] .summary-arrow {
    transform: rotate(90deg);
  }

  .accounts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
    margin-top: 12px;
  }

  .account-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: color-mix(in srgb, var(--color-text-main) 6%, transparent);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.9rem;
  }

  .account-service {
    color: var(--color-text-main);
    flex-shrink: 0;
  }

  .account-link {
    color: #1c87ed;
    text-decoration: underline;
    word-break: break-all;
    text-align: right;
    margin-left: auto;
    transition: opacity 0.2s;
  }

  .account-link:hover {
    opacity: 0.8;
  }

  .account-val {
    color: var(--color-text-main);
    opacity: 0.8;
    word-break: break-all;
    text-align: right;
    margin-left: auto;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .section-header h2 {
    font-size: 1.5rem;
    margin: 0;
    color: var(--color-text-main);
  }

  .events-count {
    color: var(--color-main);
    font-size: 1.2rem;
    font-weight: normal;
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
  }

  .year-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(0, 0, 0, 0.7);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 3px 8px;
    border-radius: 6px;
    backdrop-filter: blur(4px);
    z-index: 1;
  }

  .no-events-card {
    background: var(--color-bg-subtle, rgba(0, 0, 0, 0.02));
    border: 1px dashed var(--color-border, rgba(0, 0, 0, 0.15));
    border-radius: 12px;
    padding: 40px;
    text-align: center;
    color: var(--color-text-sub, #6b7280);
  }

  @media screen and (max-width: 767px) {
    .organizer-profile-card {
      padding: 16px;
    }

    .accounts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
