---
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/events.css";
import { getAllEvents, getEventsByYear } from "../../../utils/events";
import { getTagColorClass } from "../../../utils/tags";
import { CURRENT_YEAR } from "../../../config/site";

// generate a unique page for each item in events.json
export async function getStaticPaths() {
  const allEvents = getAllEvents();
  return allEvents.map((project) => ({
    params: { year: project.year, id: project.id }, // url path
    props: { project }, // page data
  }));
}

const { project } = Astro.props;
const { year } = Astro.params;
const isLatest = year === CURRENT_YEAR;
const eventsBasePath = isLatest ? "/events/" : `/${year}/events/`;

const yearEvents = getEventsByYear(year);
const uniqueCampuses = new Set(
  yearEvents.flatMap((e) => e.tags?.campus || (e.campusName ? [e.campusName] : [])),
);
const showCampusTag = uniqueCampuses.size > 1;

const allProjectTags = [
  ...new Set([
    ...(showCampusTag ? (project.tags?.campus || []) : []),
    ...(project.tags?.date || []),
    ...(project.tags?.format || []),
    ...(project.tags?.field || []),
    ...(project.tags?.features || []),
  ]),
];
---

<Layout title={`${project.name}｜学祭ポータル`} hideNav={true} year={year}>
  <button onclick={`location.href='${eventsBasePath}'`} class="back-button">←戻る</button>
  <button class="share-button"
    ><img src="/img/icons/share.svg" alt="シェア" /></button
  >

  <div class="event-container">
    <div class="event-left-col">
      <img class="image-relative" src={project.image} alt={project.name} />
      <div class="title">
        <img
          class="campus-icon"
          src="/img/icons/campus_icon_test.svg"
          alt="アイコン"
        />
        <h1>{project.name}</h1>
      </div>
      <button class="main-btn" id="tutorial-btn-event-introduction">
        このページの使い方
      </button>
    </div>

    <div class="event-right-col">
      <hr class="event-hr mobile-only" />
      <div class="event">
        <h2>企画名</h2>
        <p class="event-name">{project.name}</p>
        <section class="button-list">
          <!-- generate tag buttons from the 4-category or array tag data -->
          {
            allProjectTags.map((tag) => (
              <button
                class={`main-btn ${getTagColorClass(tag)}`}
                onclick={`location.href='${eventsBasePath}?tags=${encodeURIComponent(tag)}'`}
              >
                #{tag}
              </button>
            ))
          }
        </section>
      </div>
      <hr />
      <div class="date">
        <h2>開催日時</h2>
        <p>{project.datetime}</p>
      </div>
      <hr />
      <div class="place">
        <h2>場所</h2>
        <p>{project.place?.campus}</p>
        <p>{project.place?.room}</p>
        <button class="main-btn" id="maps-btn">キャンパスマップ →</button>
      </div>
      <hr />
      <div class="info">
        <h2>このイベントについて</h2>
        <p>{project.description}</p>
      </div>
      <hr />
      <div class="accounts">
        <h2>公式アカウント</h2>
        <!-- loop through the accounts object to display keys and values -->
        {
          project.accounts && Object.entries(project.accounts).map(([service, accountId]) => (
            <p>
              {service}: {accountId}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<style>
  @media screen and (max-width: 767px) {
    .title h1 {
      font-size: 1.35rem;
    }

    img.campus-icon {
      margin-bottom: 8px;
    }
  }
</style>
