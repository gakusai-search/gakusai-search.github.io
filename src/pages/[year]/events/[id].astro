---
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/events.css";
import { getAllEvents, getEventsByYear, getCampusIconSrc } from "../../../utils/events";
import { getTagColorClass } from "../../../utils/tags";
import { CURRENT_YEAR } from "../../../config/site";

// generate a unique page for each item in events.json
export async function getStaticPaths() {
  const allEvents = getAllEvents();
  return allEvents.map((project) => ({
    params: { year: project.year, id: project.id }, // url path
    props: { project }, // page data
  }));
}

const { project } = Astro.props;
const { year } = Astro.params;
const isLatest = year === CURRENT_YEAR;
const eventsBasePath = isLatest ? "/events/" : `/${year}/events/`;

const yearEvents = getEventsByYear(year);
const uniqueCampuses = new Set(
  yearEvents.map((e) => e.campusName || e.place?.campus).filter(Boolean),
);
const showCampusTag = uniqueCampuses.size > 1;

const allProjectTags = [
  ...new Set([
    ...(showCampusTag && project.campusName ? [project.campusName] : []),
    ...(project.tags?.date || []),
    ...(project.tags?.format || []),
    ...(project.tags?.field || []),
    ...(project.tags?.features || []),
  ]),
];

const campusIconSrc = project.campusIconSrc || getCampusIconSrc(project.campusId);

const [univ, campus] = (project.campusId || "").split("-");
const floorMatch = project.place?.room?.match(/(\d+)階/);
const floor = floorMatch ? `floor-${floorMatch[1]}` : null;
const building = "mb";
const mapsQuery =
  univ && campus && floor
    ? new URLSearchParams({
        univ,
        campus,
        building,
        floor,
      }).toString()
    : "";
const mapsUrl = mapsQuery ? `/roomguide/?${mapsQuery}` : "/roomguide/";
---

<Layout title={`${project.name}｜学祭ポータル`} hideNav={true} year={year}>
  <button
    onclick="if (window.history.length > 1 && document.referrer && document.referrer.startsWith(window.location.origin)) { history.back(); } else { location.href='/events/'; }"
    class="back-button">←戻る</button
  >
  <button class="share-button"
    ><img src="/img/icons/share.svg" alt="シェア" /></button
  >

  <div class="event-container">
    <div class="event-left-col">
      <img class="image-relative" src={project.image} alt={project.name} />
      <div class="title">
        <img
          class="campus-icon"
          src={campusIconSrc}
          alt="アイコン"
          onerror="this.onerror=null; this.src='/img/icons/campus-icon_test.svg';"
        />
        <h1 class="event-title">{project.name}</h1>
      </div>
      <button class="main-btn" id="tutorial-btn-event-introduction">
        このページの使い方
      </button>
    </div>

    <div class="event-right-col">
      <hr class="event-hr mobile-only" />
      <div class="event">
        <h2>この企画について</h2>
        {
          project.organizerName && (
            <div class="organizer-lead-wrapper">
              <a
                href={`/organizers/${project.organizerId}`}
                class="organizer-btn"
              >
                <span class="organizer-btn-name">{project.organizerName}</span>
                <img
                  src="/img/maps/arrow.svg"
                  alt=""
                  class="organizer-btn-arrow"
                />
              </a>
            </div>
          )
        }
        <p class="event-description">{project.description}</p>
        <section class="button-list">
          <!-- generate tag buttons from the 4-category or array tag data -->
          {
            allProjectTags.map((tag) => (
              <button
                class={`main-btn ${getTagColorClass(tag)}`}
                onclick={`location.href='${eventsBasePath}?tags=${encodeURIComponent(tag)}'`}
              >
                #{tag}
              </button>
            ))
          }
        </section>
      </div>
      <hr />
      <div class="date">
        <h2>開催日時</h2>
        <p>{project.datetime}</p>
      </div>
      <hr />
      <div class="place">
        <h2>場所</h2>
        <p>{project.campusName || project.place?.campus}</p>
        <p>{project.place?.room}</p>
        <a href={mapsUrl} class="main-btn" id="maps-btn">キャンパスマップ →</a>
      </div>
      <hr />
      <div class="accounts">
        <h2>公式アカウント</h2>
        <!-- loop through the accounts object to display keys and values -->
        {
          project.accounts &&
            Object.entries(project.accounts).map(([service, accountId]) => (
              <p>
                {service}: {accountId}
              </p>
            ))
        }
      </div>
    </div>
  </div>
</Layout>

<style>
  .organizer-lead-wrapper {
    margin: 6px 0 14px;
  }

  .organizer-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background-color: var(--color-btn-main);
    border: 1px solid var(--color-border-main);
    border-radius: 12px;
    text-decoration: none;
    color: var(--color-text-main);
    max-width: 100%;
    box-sizing: border-box;
  }

  .organizer-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .organizer-btn:active::before {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0.4);
    transition: background-color 0.1s ease;
  }

  @media (hover: hover) {
    .organizer-btn:hover::before {
      opacity: 1;
    }
  }

  .organizer-btn-name {
    font-size: 1.1rem;
    line-height: 1.4;
    color: var(--color-text-main);
    word-break: break-word;
    display: inline-block;
  }

  .organizer-btn-arrow {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: block;
    align-self: center;
  }

  .title {
    align-items: center;
  }

  .campus-icon {
    flex-shrink: 0;
    align-self: center;
  }

  #maps-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
  }

  @media screen and (max-width: 767px) {
    .event-title {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      word-break: break-word;
      user-select: none;
      -webkit-user-select: none;
    }

    .event-title.is-clampable {
      cursor: pointer;
      -webkit-tap-highlight-color: rgba(255, 255, 255, 0.1);
    }

    .event-title.is-clampable:active {
      opacity: 0.8;
    }

    .event-title.is-clampable.is-expanded {
      display: block;
      -webkit-line-clamp: unset;
      overflow: visible;
    }
  }
</style>

<script>
  function setupTitleClamp() {
    const titleEl = document.querySelector<HTMLElement>(".event-title");
    if (!titleEl) return;

    const checkClamp = () => {
      const isMobile = window.matchMedia("(max-width: 767px)").matches;
      if (!isMobile) {
        titleEl.classList.remove("is-clampable", "is-expanded");
        titleEl.removeAttribute("role");
        titleEl.removeAttribute("tabindex");
        titleEl.removeAttribute("aria-expanded");
        return;
      }

      const wasExpanded = titleEl.classList.contains("is-expanded");
      if (wasExpanded) {
        titleEl.classList.remove("is-expanded");
      }

      const isClamped = titleEl.scrollHeight > titleEl.clientHeight + 1;

      if (isClamped) {
        titleEl.classList.add("is-clampable");
        titleEl.setAttribute("role", "button");
        titleEl.setAttribute("tabindex", "0");
        if (wasExpanded) {
          titleEl.classList.add("is-expanded");
          titleEl.setAttribute("aria-expanded", "true");
        } else {
          titleEl.setAttribute("aria-expanded", "false");
        }
      } else {
        titleEl.classList.remove("is-clampable", "is-expanded");
        titleEl.removeAttribute("role");
        titleEl.removeAttribute("tabindex");
        titleEl.removeAttribute("aria-expanded");
      }
    };

    checkClamp();

    if (!(titleEl as any)._hasClampListener) {
      (titleEl as any)._hasClampListener = true;

      titleEl.addEventListener("click", () => {
        if (!titleEl.classList.contains("is-clampable")) return;
        const willExpand = !titleEl.classList.contains("is-expanded");
        titleEl.classList.toggle("is-expanded", willExpand);
        titleEl.setAttribute("aria-expanded", willExpand ? "true" : "false");
      });

      titleEl.addEventListener("keydown", (e) => {
        if (!titleEl.classList.contains("is-clampable")) return;
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          titleEl.click();
        }
      });

      window.addEventListener("resize", checkClamp);
      if ("fonts" in document) {
        document.fonts.ready.then(checkClamp);
      }
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTitleClamp);
  } else {
    setupTitleClamp();
  }
  document.addEventListener("astro:page-load", setupTitleClamp);
</script>
