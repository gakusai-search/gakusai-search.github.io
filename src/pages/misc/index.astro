---
import Layout from "../../layouts/Layout.astro";
import TutorialButton from "../../components/TutorialButton.astro";
import "../../styles/misc.css";
import { CURRENT_YEAR } from "../../config/site";
import { getCampusesByYear, getCampusIconSrc } from "../../utils/events";

const campuses = getCampusesByYear(CURRENT_YEAR);

const partnerUniversities = [
  {
    campusId: "chuo-itl",
    links: [
      {
        type: "web",
        label: "学祭公式サイト",
        text: "itlfest.com",
        url: "https://itlfest.com/",
      },
      {
        type: "instagram",
        label: "Instagram",
        text: "@festival_itl",
        url: "https://www.instagram.com/festival_itl",
      },
      {
        type: "x",
        label: "X (Twitter)",
        text: "@Festival_iTL",
        url: "https://x.com/Festival_iTL",
      },
      {
        type: "line",
        label: "LINE",
        text: "@513fripZ",
        url: "https://line.me/R/ti/p/@513fripZ",
      },
      {
        type: "threads",
        label: "Threads",
        text: "@festival_itl",
        url: "https://www.threads.com/@festival_itl",
      },
    ],
  },
];
---

<Layout title="その他｜学祭ポータル">
  <div class="page-header">
    <div class="page-title">
      <img src="/img/misc/misc.svg" alt="その他アイコン" class="page-icon" />
      <h1>その他</h1>
    </div>
    <TutorialButton pageKey="misc" />
  </div>

  <hr />

  <h2 class="section-title">サイト外観の設定</h2>
  <div class="setting-card">
    <label class="radio-option">
      <input type="radio" name="theme" value="system" checked />
      <span class="custom-radio"></span>
      <span class="radio-text">端末での設定にあわせる</span>
    </label>
    <label class="radio-option">
      <input type="radio" name="theme" value="light" />
      <span class="custom-radio"></span>
      <span class="radio-text">ライトモード</span>
    </label>
    <label class="radio-option">
      <input type="radio" name="theme" value="dark" />
      <span class="custom-radio"></span>
      <span class="radio-text">ダークモード</span>
    </label>
  </div>

  <hr />

  <h2 class="section-title">協力大学 学祭公式サイト</h2>
  <div class="partner-list">
    {
      partnerUniversities.map((partner) => {
        const campus = campuses.find((c) => c.id === partner.campusId);
        const name = campus?.name || partner.campusId;
        const festivalName = campus?.festivalName || "";
        const iconSrc = getCampusIconSrc(partner.campusId);

        return (
          <div class="partner-card">
            <div class="partner-header">
              <img
                class="partner-icon"
                src={iconSrc}
                alt="アイコン"
                onerror="this.onerror=null; this.src='/img/icons/campus-icon_test.svg';"
              />
              <div class="partner-title-group">
                <div class="partner-name">{name}</div>
                {festivalName && (
                  <div class="partner-fest">{festivalName}</div>
                )}
              </div>
            </div>
            {partner.links && partner.links.length > 0 && (
              <div class="partner-links">
                {partner.links.map((link) => (
                  <div class="partner-link-row">
                    <div class="link-label-group">
                      <img
                        src={`/img/icons/social-icon_${link.type}.svg`}
                        alt={link.label}
                        class="link-icon"
                      />
                      <span class="link-label-text">{link.label}</span>
                    </div>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-url-text"
                    >
                      {link.text}
                    </a>
                  </div>
                ))}
              </div>
            )}
          </div>
        );
      })
    }
  </div>
  <hr />
  <h2 class="section-title">お問い合わせ</h2>
  <p>準備中</p>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const savedTheme = localStorage.getItem("theme") || "system";
      const radioInputs = document.querySelectorAll('input[name="theme"]');

      radioInputs.forEach((radio) => {
        if (radio.value === savedTheme) {
          radio.checked = true;
        }

        radio.addEventListener("change", (e) => {
          const selectedTheme = e.target.value;
          localStorage.setItem("theme", selectedTheme);

          if (selectedTheme === "light" || selectedTheme === "dark") {
            document.documentElement.setAttribute("data-theme", selectedTheme);
          } else {
            document.documentElement.removeAttribute("data-theme");
          }
        });
      });
    });
  </script>
</Layout>
