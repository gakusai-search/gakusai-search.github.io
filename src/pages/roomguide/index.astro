---
import Layout from "../../layouts/Layout.astro";
import TutorialButton from "../../components/TutorialButton.astro";
import "../../styles/roomguide.css";
---

<Layout title="教室案内｜学祭ポータル">
  <div class="roomgjuide-main">
    <div class="page-header">
      <div class="page-title">
        <img
          class="page-icon"
          src="/img/roomguide/roomguide.svg"
          alt="教室案内アイコン"
        />
        <h1>教室案内</h1>
      </div>
      <TutorialButton pageKey="roomguide" />
      <hr />
    </div>
    <div class="roomguide-middle-col">
      <h2 class="section-title">場所を検索</h2>
      <select class="roomguide-btn" id="univ_select">
        <option value="none">大学を選択</option>
        <option value="chuo">中央大学</option>
      </select>
      <select class="roomguide-btn" id="campus_select">
        <option value="none">キャンパスを選択</option>
        <option value="itl">市ヶ谷田町キャンパス</option>
      </select>
      <select class="roomguide-btn" id="buildings_select">
        <option value="none">建物を選択</option>
        <option value="mb">ミドルブリッジ</option>
      </select>
      <select class="roomguide-btn" id="fl_select">
        <option value="none">階数を選択</option>
        <option value="floor-1">1階</option>
        <option value="floor-3">3階</option>
        <option value="floor-4">4階</option>
        <option value="floor-5">5階</option>
        <option value="floor-6">6階</option>
        <option value="floor-7">7階</option>
        <option value="floor-8">8階</option>
        <option value="floor-9">9階</option>
        <option value="floor-10">10階</option>
        <option value="none">2階、および11階は立入できません</option>
      </select>
      <button class="roomguide-search-btn" id="access-code">
        フロアマップを見る
      </button>
    </div>
    <div class="roomguide-map" id="roomguide-map" style="display:none;">
      <div class="map-card">
        <div class="grid-container">
          <div class="grid-item">
            <img
              id="campus-icon"
              src="/img/icons/campus-icon_test.svg"
              class="access-info-icon"
              alt="アイコン"
              onerror="this.onerror=null; this.src='/img/icons/campus-icon_test.svg';"
            />
          </div>

          <div class="grid-item">
            <p class="grid-item-title" id="floor-main"></p>
            <p class="grid-item-description" id="floor-sub"></p>
          </div>
        </div>
        <img id="display-image" src="" alt="フロアマップ" class="maps-image" />
      </div>
    </div>
  </div>
</Layout>

<script>
  const selects =
    document.querySelectorAll<HTMLSelectElement>(".roomguide-btn");

  // 上から順に選ばないと次には進めないよ
  selects.forEach((select, index) => {
    if (index !== 0) {
      select.disabled = true;
    }

    select.addEventListener("change", () => {
      const nextSelect = selects[index + 1];
      const selectedValue = select.value;
      if (nextSelect) {
        if (selectedValue === "none") {
          nextSelect.disabled = true;
        } else {
          nextSelect.disabled = false;
        }
      }
    });
  });

  // 選択肢を変えた時にあとの選択肢は初期化しなきゃ
  selects.forEach((select, index) => {
    select.addEventListener("change", () => {
      for (let i = index + 2; i < selects.length; i++) {
        selects[i].disabled = true;
      }
      for (let i = index + 1; i < selects.length; i++) {
        selects[i].selectedIndex = 0;
      }
    });
  });

  // 検索ボタンの有効化したり無効化したり
  const searchBtn = document.getElementById(
    "access-code",
  ) as HTMLButtonElement | null;

  function updateSearchBtn() {
    if (!searchBtn) return;
    const ready = [...selects].every((s) => s.value !== "none");
    searchBtn.disabled = !ready;
    searchBtn.classList.toggle("activated", ready);
  }

  selects.forEach((select) =>
    select.addEventListener("change", updateSearchBtn),
  );
  updateSearchBtn();

  // 取得したvalueからアイコン、テキスト、画像を次々と決める
  const univSelect = document.getElementById(
    "univ_select",
  ) as HTMLSelectElement | null;
  const campusSelect = document.getElementById(
    "campus_select",
  ) as HTMLSelectElement | null;
  const buildingsSelect = document.getElementById(
    "buildings_select",
  ) as HTMLSelectElement | null;
  const flSelect = document.getElementById(
    "fl_select",
  ) as HTMLSelectElement | null;
  const roomguideMap = document.getElementById("roomguide-map");
  const img = document.getElementById(
    "display-image",
  ) as HTMLImageElement | null;
  const floorMain = document.getElementById("floor-main");
  const floorSub = document.getElementById("floor-sub");
  const campusIconFile = document.getElementById(
    "campus-icon",
  ) as HTMLImageElement | null;

  if (
    searchBtn &&
    univSelect &&
    campusSelect &&
    buildingsSelect &&
    flSelect &&
    roomguideMap &&
    img &&
    floorMain &&
    floorSub &&
    campusIconFile
  ) {
    searchBtn.addEventListener("click", () => {
      const univ = univSelect.value;
      const campus = campusSelect.value;
      const building = buildingsSelect.value;
      const floor = flSelect.value;

      if (
        univ === "none" ||
        campus === "none" ||
        building === "none" ||
        floor === "none"
      ) {
        return;
      }

      const campusId = `${univ}-${campus}`;
      const imageSrc = `/img/roomguide/${campusId}/${building}/${floor}.png`;
      const iconSrc = `/img/icons/campus-icon_${campusId}.svg`;

      const mainText = `${univSelect.options[univSelect.selectedIndex].text} ${campusSelect.options[campusSelect.selectedIndex].text}`;
      const subText = `${buildingsSelect.options[buildingsSelect.selectedIndex].text} ${flSelect.options[flSelect.selectedIndex].text}`;

      // 画像の存在を確認してからフロアマップカードを表示しよう
      const tempImg = new Image();
      tempImg.onload = () => {
        img.src = imageSrc;
        floorMain.textContent = mainText;
        floorSub.textContent = subText;
        campusIconFile.onerror = function () {
          this.onerror = null;
          this.src = "/img/icons/campus-icon_test.svg";
        };
        campusIconFile.src = iconSrc;
        roomguideMap.style.display = "block";
        if (window.location.search) {
          roomguideMap.scrollIntoView({ behavior: "smooth" });
        }
      };
      tempImg.onerror = () => {
        img.src = "";
        roomguideMap.style.display = "none";
        alert("この場所のフロアマップは現在準備中です");
        console.warn("floor map is not prepared now. coming soon:", imageSrc);
      };
      tempImg.src = imageSrc;
    });

    // URLで受け取ったら自動で選ぶよ
    const params = new URLSearchParams(window.location.search);
    const univParam = params.get("univ");
    const campusParam = params.get("campus");
    const buildingParam = params.get("building");
    const floorParam = params.get("floor");

    if (univParam && campusParam && buildingParam && floorParam) {
      const setSelectValue = (select: HTMLSelectElement, val: string) => {
        const optionExists = Array.from(select.options).some(
          (opt) => opt.value === val,
        );
        if (optionExists) {
          select.value = val;
          select.disabled = false;
          return true;
        }
        return false;
      };

      const univValid = setSelectValue(univSelect, univParam);
      const campusValid =
        univValid && setSelectValue(campusSelect, campusParam);
      const buildingValid =
        campusValid && setSelectValue(buildingsSelect, buildingParam);
      const floorValid = buildingValid && setSelectValue(flSelect, floorParam);

      if (univValid && campusValid && buildingValid && floorValid) {
        updateSearchBtn();
        searchBtn.click();
      }
    }
  }
</script>
