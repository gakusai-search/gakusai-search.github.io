---
import Layout from "../../layouts/Layout.astro";
import "../../styles/roomguide.css";
---

<Layout title="教室案内｜学祭ポータル">
  <div class="roomguide-container">
    <div class="roomguide-upside-col page-header">
      <div class="page-title">
        <img
          class="page-icon"
          src="/img/roomguide/roomguide.svg"
          alt="教室案内アイコン"
        />
        <h1>教室案内</h1>
      </div>
      <button
        class="main-btn tutorial-btn"
        id="tutorial-btn-event-introduction"
      >
        このページの使い方
      </button>
      <hr />
    </div>
    <div class="roomguide-middle-col">
      <h2>出発地</h2>
      <button class="roomguide-btn" disabled> キャンパス入口（正門） </button>
      <h2>到着地</h2>
      <button class="roomguide-btn" popovertarget="campus_select">
        キャンパスを選択
      </button>
      <div id="campus_select" popover>
        <select>
          <option>市ヶ谷田町キャンパス</option>
          <option>多摩キャンパス</option>
          <option>後楽園キャンパス</option>
          <option>茗荷谷キャンパス</option>
        </select>
      </div>
      <br />
      <button class="roomguide-btn" popovertarget="buildings_select">
        建物を選択
      </button>
      <div id="buildings_select" popover>
        <select>
          <option>本館</option>
          <option>別館</option>
          <option>イティエルの家</option>
        </select>
      </div>
      <br />
      <button class="roomguide-btn" popovertarget="classrooms_select">
        教室を選択
      </button>
      <div id="classrooms_select" popover>
        <select>
          <option>ベランダ</option>
          <option>301</option>
          <option>309カフェ</option>
          <option>ヘリポートなんかねえよ</option>
        </select>
      </div>
      <br />
      <button class="roomguide-search-btn"> 案内を見る </button>
    </div>
    <div class="roomguide-downside-col"></div>
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll(".roomguide-btn");

  buttons.forEach((btn) => {
    const targetId = btn.getAttribute("popovertarget");
    if (!targetId) return;
    const popover = document.getElementById(targetId);
    if (!popover) return;

    popover.addEventListener("beforetoggle", (event) => {
      if (event.newState === "open") {
        const rect = btn.getBoundingClientRect();
        popover.style.position = "fixed";
        popover.style.top = rect.bottom + "px";
        popover.style.left = rect.left + "px";
        popover.style.margin = "0";
      }
    });

    const select = popover.querySelector("select");
    if (!select) return;
    select.addEventListener("change", () => {
      const selectedText = select.options[select.selectedIndex].text;
      btn.textContent = selectedText;
      popover.hidePopover();
    });
  });
</script>
