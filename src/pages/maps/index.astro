---
import Layout from "../../layouts/Layout.astro";
import "../../styles/maps.css";
---

<Layout title="キャンパスマップ｜学祭ポータル">
  <div class="page-header">
    <div class="page-title">
      <img src="/img/maps/maps.svg" alt="マップアイコン" class="page-icon" />
      <h1>キャンパスマップ</h1>
    </div>
    <button class="main-btn tutorial-btn" id="tutorial-btn-event-introduction">
      このページの使い方
    </button>
  </div>
  <hr />
  <h2>ご来場の際のご案内</h2>
  <button class="access info1">
    車いすスペース・優先席のご案内
    <span>バリアフリー設備・優先席のご案内をご確認いただけます</span>
  </button>
</Layout>
