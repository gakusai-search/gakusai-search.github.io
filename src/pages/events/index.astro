---
import Layout from "../../layouts/Layout.astro";
import projects from "../../data/events.json";

const categories = [
  {
    key: "date",
    title: "日程",
    tags: [...new Set(projects.flatMap((p) => p.tags.date))],
  },
  {
    key: "format",
    title: "形式",
    tags: [...new Set(projects.flatMap((p) => p.tags.format))],
  },
  {
    key: "field",
    title: "分野",
    tags: [...new Set(projects.flatMap((p) => p.tags.field))],
  },
  {
    key: "features",
    title: "気になる条件",
    tags: [...new Set(projects.flatMap((p) => p.tags.features))],
  },
];
---

<Layout title="検索結果｜学祭ポータル">
  <div class="page-header">
    <div class="page-title">
      <img
        src="/img/events/search_page.svg"
        alt="検索結果アイコン"
        class="page-icon"
      />
      <h1>検索結果</h1>
    </div>
    <div class="events-header-bar">
      <button
        class="main-btn tutorial-btn"
        id="tutorial-btn-event-introduction"
      >
        このページの使い方
      </button>
      <div class="events-count" id="events-count">
        {projects.length}件
      </div>
    </div>
  </div>

  <hr />

  <!-- UI component for filtering projects by selecting tags -->
  <div class="tag-filter-container" id="tag-filter">
    <div class="tag-filter-top">
      <h2>タグで探す</h2>
      <button class="main-btn filter-btn active" data-tag="all">すべて</button>
    </div>

    <div class="tag-categories-wrapper">
      {
        categories.map(
          (category) =>
            category.tags.length > 0 && (
              <div class="tag-category-section">
                <h3 class="tag-category-title">{category.title}</h3>
                <div class="tag-list">
                  {category.tags.map((tag) => (
                    <button
                      class="main-btn filter-btn"
                      data-category={category.key}
                      data-tag={tag}
                    >
                      #{tag}
                    </button>
                  ))}
                </div>
              </div>
            ),
        )
      }
    </div>
  </div>

  <!-- event cards -->
  <div class="events-grid">
    {
      projects.map((project) => {
        const allTags = [
          ...project.tags.date,
          ...project.tags.format,
          ...project.tags.field,
          ...project.tags.features,
        ];
        return (
          <a
            href={`/events/${project.id}`}
            class="event-card"
            data-tags-date={project.tags.date.join(",")}
            data-tags-format={project.tags.format.join(",")}
            data-tags-field={project.tags.field.join(",")}
            data-tags-features={project.tags.features.join(",")}
          >
            <img src={project.image} alt={project.name} loading="lazy" />
            <div class="event-card-content">
              <h3>{project.name}</h3>
              <p class="campus-text">{project.place.campus}</p>
              <div class="event-card-tags">
                {allTags.map((tag) => (
                  <span class="tag-span">#{tag}</span>
                ))}
              </div>
            </div>
          </a>
        );
      })
    }
  </div>

  <!-- style only for this page -->
  <style>
    hr {
      margin-top: 0px;
    }

    .events-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.8em;
    }

    .events-header-bar .tutorial-btn {
      margin-bottom: 0;
    }

    .events-count {
      color: var(--color-main);
      font-size: 20px;
      text-align: right;
    }

    @media (max-width: 319.98px) {
      .events-header-bar {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
      }

      .events-count {
        text-align: left;
      }
    }

    .tag-filter-container {
      margin: 20px 0 0 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
      display: none;
    }

    .tag-filter-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .tag-filter-top h2 {
      margin: 0;
      font-size: 20px;
      text-align: left;
    }

    .tag-categories-wrapper {
      display: flex;
      flex-direction: column;
      gap: 16px;
      background-color: var(--color-btn-main);
      border: 1.5px solid var(--color-border-main);
      border-radius: 14px;
      padding: 16px 20px;
      box-sizing: border-box;
    }

    .tag-category-section {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .tag-category-title {
      margin: 0;
      font-size: 15px;
      font-weight: bold;
      color: var(--color-text-main);
      text-align: left;
    }

    .tag-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 8px;
    }
  </style>

  <!-- JS code for filtering: multiple selection (same category: OR, different categories: AND) -->
  <script is:inline>
    const initFilter = () => {
      const filterContainer = document.getElementById("tag-filter");
      if (!filterContainer) return;

      const allBtn = filterContainer.querySelector(
        '.filter-btn[data-tag="all"]',
      );
      const tagBtns = filterContainer.querySelectorAll(
        '.filter-btn:not([data-tag="all"])',
      );
      const eventCards = document.querySelectorAll(".event-card");

      function updateFiltering() {
        // 1. collect selected tags for each category
        const selectedByCat = {
          date: [],
          format: [],
          field: [],
          features: [],
        };

        let totalSelected = 0;
        tagBtns.forEach((btn) => {
          if (btn.classList.contains("active")) {
            const cat = btn.getAttribute("data-category");
            const tag = btn.getAttribute("data-tag");
            if (cat && selectedByCat[cat]) {
              selectedByCat[cat].push(tag);
              totalSelected++;
            }
          }
        });

        const countEl = document.getElementById("events-count");

        // activate 'All' and show all cards if no tags are selected
        if (totalSelected === 0) {
          if (allBtn) allBtn.classList.add("active");
          eventCards.forEach((card) => card.classList.remove("hidden"));
          if (countEl) {
            countEl.textContent = `${eventCards.length}件`;
          }
          return;
        } else {
          if (allBtn) allBtn.classList.remove("active");
        }

        // 2. check if each card matches: OR within the same category, AND between different categories
        let visibleCount = 0;
        eventCards.forEach((card) => {
          let matches = true;

          for (const [catKey, selectedTags] of Object.entries(selectedByCat)) {
            // if no tag is selected in this category, just skip
            if (selectedTags.length === 0) continue;

            // get the tags of that category the card has
            const cardAttr = card.getAttribute(`data-tags-${catKey}`);
            const cardTags = cardAttr
              ? cardAttr.split(",").filter(Boolean)
              : [];

            // OR within the same category: if any of the selected tags is included in the card tags
            const hasAnyTag = selectedTags.some((tag) =>
              cardTags.includes(tag),
            );

            if (!hasAnyTag) {
              matches = false;
              break; // AND between different categories
            }
          }

          if (matches) {
            card.classList.remove("hidden");
            visibleCount++;
          } else {
            card.classList.add("hidden");
          }
        });

        if (countEl) {
          countEl.textContent = `${visibleCount}件`;
        }
      }

      function syncUrlWithState() {
        const activeTags = [];
        tagBtns.forEach((btn) => {
          if (btn.classList.contains("active")) {
            const tag = btn.getAttribute("data-tag");
            if (tag) activeTags.push(tag);
          }
        });

        const currentUrl = new URL(window.location.href);
        if (activeTags.length > 0) {
          currentUrl.searchParams.set("tags", activeTags.join(","));
        } else {
          currentUrl.searchParams.delete("tags");
        }
        window.history.replaceState({}, "", currentUrl.toString());
      }

      function applyUrlParams() {
        const params = new URLSearchParams(window.location.search);
        const urlTags = params
          .getAll("tags")
          .flatMap((t) => t.split(","))
          .map((t) => t.trim())
          .filter(Boolean);

        if (urlTags.length > 0) {
          let hasMatch = false;
          tagBtns.forEach((btn) => {
            const tag = btn.getAttribute("data-tag");
            if (tag && urlTags.includes(tag)) {
              btn.classList.add("active");
              hasMatch = true;
            } else {
              btn.classList.remove("active");
            }
          });

          if (hasMatch) {
            if (allBtn) allBtn.classList.remove("active");
          } else {
            if (allBtn) allBtn.classList.add("active");
          }
        } else {
          tagBtns.forEach((btn) => btn.classList.remove("active"));
          if (allBtn) allBtn.classList.add("active");
        }

        updateFiltering();
      }

      // 'All' button click
      if (allBtn) {
        allBtn.addEventListener("click", () => {
          tagBtns.forEach((btn) => btn.classList.remove("active"));
          allBtn.classList.add("active");
          updateFiltering();
          syncUrlWithState();
        });
      }

      // each tag button click (toggle selection)
      tagBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          btn.classList.toggle("active");
          updateFiltering();
          syncUrlWithState();
        });
      });

      // browser history navigation (back/forward)
      window.addEventListener("popstate", applyUrlParams);

      // initial apply from URL
      applyUrlParams();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initFilter);
    } else {
      initFilter();
    }
  </script>
</Layout>
