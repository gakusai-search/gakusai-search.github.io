---
import Layout from "../../layouts/Layout.astro";
import projects from "../../data/events.json";

// generates an array of unique tags from all project data automatically
const allTags = [...new Set(projects.flatMap((project) => project.tags))];
---

<Layout title="企画一覧｜学祭ポータル">
  <h1>企画一覧</h1>

  <!-- UI component for filtering projects by selecting tags -->
  <div class="tag-filter-container">
    <h2>タグで探す</h2>
    <div class="tag-list" id="tag-filter">
      <!-- "all" button -->
      <button class="main-btn filter-btn active" data-tag="all">すべて</button>

      <!-- rendering the extracted unique tags as a list of interactive buttons -->
      {
        allTags.map((tag) => (
          <button class="main-btn filter-btn" data-tag={tag}>
            #{tag}
          </button>
        ))
      }
    </div>
  </div>

  <hr />

  <!-- event cards -->
  <div class="events-grid">
    {
      projects.map((project) => (
        // using the comma-separated values in the data-tags attribute for JavaScript filtering
        <a
          href={`/events/${project.id}`}
          class="event-card"
          data-tags={project.tags.join(",")}
        >
          <img src={project.image} alt={project.name} loading="lazy" />
          <div class="event-card-content">
            <h3>{project.name}</h3>
            <p class="campus-text">{project.place.campus}</p>
            <div class="event-card-tags">
              {project.tags.map((tag) => (
                <span class="tag-span">#{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <!-- style only for this page -->
  <style>
    .tag-filter-container {
      margin: 20px;
      text-align: center;
    }
    .tag-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }
    .filter-btn.active {
      background: var(--color-main);
      border-color: var(--color-main);
    }

    .events-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 20px;
      max-width: 1200px;
      margin: 0 auto;
    }
    /* responsive ui */
    @media (min-width: 768px) {
      .events-grid {
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      }
    }

    .event-card {
      display: block;
      background-color: var(--color-btn-main);
      border: 1px solid var(--color-border-main);
      border-radius: 12px;
      overflow: hidden;
      text-decoration: none;
      transition: transform 0.2s;
    }
    .event-card:hover {
      transform: translateY(-4px);
    }
    .event-card img {
      width: 100%;
      height: 180px;
      object-fit: cover;
    }
    .event-card-content {
      padding: 16px;
    }
    .event-card-content h3 {
      margin: 0 0 12px 0;
      font-size: 18px;
      text-align: left;
    }
    .campus-text {
      font-size: 14px;
      color: #ccc;
      text-align: left;
      margin-bottom: 12px;
    }
    .event-card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .tag-span {
      font-size: 12px;
      color: var(--color-text-main);
      background-color: rgba(255, 255, 255, 0.1);
      padding: 4px 8px;
      border-radius: 4px;
    }

    .hidden {
      display: none !important;
    }
  </style>

  <!-- JS code for filtering -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const filterBtns = document.querySelectorAll(".filter-btn");
      const eventCards = document.querySelectorAll(".event-card");

      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          // 1. toggle button active state
          filterBtns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");

          // 2. get clicked tag
          const selectedTag = btn.getAttribute("data-tag");

          // 3. determine visibility for each card
          eventCards.forEach((card) => {
            if (selectedTag === "all") {
              card.classList.remove("hidden");
            } else {
              // get card tags and verify if selected tag matches
              const cardTags = card.getAttribute("data-tags").split(",");
              if (cardTags.includes(selectedTag)) {
                card.classList.remove("hidden");
              } else {
                card.classList.add("hidden");
              }
            }
          });
        });
      });
    });
  </script>
</Layout>
