---
import EventsSearch from "../../components/portal/EventsSearch.astro";
import { CURRENT_YEAR } from "../../config/site";
import { getEventsByYear, getCampusesByYear } from "../../utils/events";

const events = getEventsByYear(CURRENT_YEAR);
const campuses = getCampusesByYear(CURRENT_YEAR);
---
<EventsSearch year={CURRENT_YEAR} projects={events} campuses={campuses} isLatest={true} />
